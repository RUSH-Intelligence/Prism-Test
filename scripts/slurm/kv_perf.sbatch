#!/bin/bash
#SBATCH --output=/scratch/sj157/kvperf_logs/%x_%j.out
#SBATCH --error=/scratch/sj157/kvperf_logs/%x_%j.err
#SBATCH --job-name=kv_perf
#SBATCH --account=as143
#SBATCH --partition=commons
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --threads-per-core=1
#SBATCH --mem-per-cpu=32GB
#SBATCH --gres=gpu:h200:1
#SBATCH --time=2:00:00
#SBATCH --export=ALL
#SBATCH --exclude=bg3u24g1
set -euo pipefail

# ---------------------------------------------------------------- env ------
module purge
module load GCCcore/13.3.0
module load CUDA/12.9.1
source /scratch/sj157/prism_env/bin/activate

# Compute nodes set LD_PRELOAD=libxalt_init.so, whose RUNPATH pulls in xalt's
# stale libcrypto.so.3 (3.2.2); python3.13 `import ssl` then dies with
# "OPENSSL_3.3.0 not found". LD_LIBRARY_PATH cannot beat an already-preloaded
# soname, so the correct pair must be preloaded AHEAD of xalt.
export LD_PRELOAD="/opt/apps/software/OpenSSL/3/lib64/libcrypto.so.3:/opt/apps/software/OpenSSL/3/lib64/libssl.so.3${LD_PRELOAD:+:$LD_PRELOAD}"

export PYTHONUNBUFFERED=1
export HF_HOME="/scratch/sj157/hf_home"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export TRANSFORMERS_CACHE="$HF_HOME/hub"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"

# Performance-specific hygiene:
#  - expandable_segments defeats the fragmentation generated by DynamicCache's
#    per-step torch.cat, which requests a slightly larger block every step.
#  - a spinning CPU thread pool is pure jitter; there are no CPU tensor ops here.
# PERSISTENT (not per-job): the rarekv CUDA extension takes ~100 s of nvcc to
# build. TORCH_EXTENSIONS_DIR must survive the job or every cell rebuilds it.
export TORCH_EXTENSIONS_DIR="/scratch/sj157/torch_extensions"
mkdir -p "$TORCH_EXTENSIONS_DIR"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
export OMP_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false

JOB_LOCAL_BASE="/scratch/sj157/kvperf_job_${SLURM_JOB_ID}"
export TMPDIR="${JOB_LOCAL_BASE}/tmp"
export XDG_CACHE_HOME="${JOB_LOCAL_BASE}/xdg-cache"
export XDG_CONFIG_HOME="${JOB_LOCAL_BASE}/xdg-config"
export TRITON_CACHE_DIR="${JOB_LOCAL_BASE}/triton"
mkdir -p "$TMPDIR" "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME" "$TRITON_CACHE_DIR"
trap 'rm -rf "${JOB_LOCAL_BASE}"' EXIT

# -------------------------------------------------------------- params -----
: "${OUTDIR:?set OUTDIR}"
: "${CONTEXT:?set CONTEXT}"
MODEL="${MODEL:-meta-llama/Llama-3.1-8B-Instruct}"
MODEL_KEY="${MODEL_KEY:-llama8b}"
METHODS="${METHODS:-knorm,cur,keydiff,snapkv,streaming_llm}"
RATIOS="${RATIOS:-0.9}"
ATTN="${ATTN:-flash_attention_2}"
DTYPE="${DTYPE:-bfloat16}"
MAXLEN="${MAXLEN:-131072}"
DECODE_STEPS="${DECODE_STEPS:-128}"
REPEATS="${REPEATS:-5}"
WARMUP="${WARMUP:-2}"
KWARGS="${KWARGS:-{\}}"
# JSON list (or @file.json) of method variants, e.g. rarekv at several (P, L).
VARIANTS="${VARIANTS:-}"
TRC="${TRC:-true}"
DEQUANT="${DEQUANT:-false}"
EXTRA_ARGS="${EXTRA_ARGS:-}"

mkdir -p "$OUTDIR"
echo "================ kv_perf ================"
echo "host=$(hostname) job=${SLURM_JOB_ID} name=${SLURM_JOB_NAME:-?}"
echo "MODEL=$MODEL CONTEXT=$CONTEXT METHODS=$METHODS RATIOS=$RATIOS ATTN=$ATTN DTYPE=$DTYPE"
echo "DECODE_STEPS=$DECODE_STEPS REPEATS=$REPEATS WARMUP=$WARMUP OUTDIR=$OUTDIR"
echo "VARIANTS=${VARIANTS:-<none>}"
echo "REPO_DIR=${REPO_DIR:-/scratch/sj157/Prism-Test}"
python --version
nvidia-smi --query-gpu=name,driver_version,memory.total,clocks.max.sm,power.limit --format=csv || true

# Timing on a shared GPU is not timing. Refuse rather than publish a bad number.
if nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | grep -q .; then
    echo "FATAL: another process holds this GPU; timing would be invalid" >&2
    nvidia-smi --query-compute-apps=pid,used_gpu_memory --format=csv >&2
    exit 3
fi

# REPO_DIR lets a sweep run from a frozen git worktree. Each cell is its own
# subprocess that re-imports the repo, so editing the working tree mid-sweep
# changes what later cells measure (and can crash one on a half-applied edit).
REPO_DIR="${REPO_DIR:-/scratch/sj157/Prism-Test}"
cd "$REPO_DIR"
export PYTHONPATH="$REPO_DIR:${PYTHONPATH:-}"
# python invoked directly, NOT via srun: srun's spank hooks re-inject xalt's
# stale libcrypto and undo the LD_PRELOAD fix above.
python "$REPO_DIR/scripts/bench_kv_perf.py" \
    --model "$MODEL" --model-key "$MODEL_KEY" \
    --methods "$METHODS" --ratios "$RATIOS" --context-lengths "$CONTEXT" \
    --attn-impl "$ATTN" --dtype "$DTYPE" --max-model-len "$MAXLEN" \
    --decode-steps "$DECODE_STEPS" --repeats "$REPEATS" --warmup-repeats "$WARMUP" \
    --kv-kwargs "$KWARGS" --out-dir "$OUTDIR" --isolation cell --resume \
    ${VARIANTS:+--method-variants "$VARIANTS"} \
    $( [[ "$TRC" == "true" ]] && echo --trust-remote-code || echo --no-trust-remote-code ) \
    $( [[ "${DEQUANT:-false}" == "true" ]] && echo --dequantize-fp8 ) \
    --tag "job${SLURM_JOB_ID}" $EXTRA_ARGS
rc=$?

nvidia-smi --query-gpu=clocks.sm,temperature.gpu,power.draw --format=csv || true
echo "FINISHED at $(date) rc=$rc"
exit $rc
